// Cloudflare Workers settings for the API. Secrets (SUPABASE_SECRET_KEY, GEMINI_API_KEY) are set with
// `npx wrangler secret put <NAME>`, never written here. Local `npm run dev:worker` reads them from .dev.vars.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "homebase-api",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "SUPABASE_URL": "https://uqbajkgaivtqiiwexwjl.supabase.co",
    "PUBLIC_API_URL": "https://homebase-api.REPLACE-WITH-SUBDOMAIN.workers.dev"
  },
  // Logs show in the Cloudflare dashboard, like Render's
  "observability": { "enabled": true }
}
